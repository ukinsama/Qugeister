// C-QNN Hybrid Model
digraph {
	rankdir=LR
	subgraph cluster_cnn {
		color=lightblue label=CNN style=filled
		Input [label=Input color=lightgray shape=oval style=filled]
		CNN0 [label="CNN layers"]
		Input -> CNN0
		CNN_out [label="CNN Output"]
		CNN0 -> CNN_out
	}
	subgraph cluster_qnn {
		color=lightpink label=QNN style=filled
		QNN_input [label="QNN Input"]
		QNN0 [label="QNN layers"]
		QNN_input -> QNN0
	}
	Output [label=Output color=lightgray shape=oval style=filled]
	QNN0 -> Output
	CNN_out -> QNN_input [constraint=True]
	fontcolor=black fontsize=20 label="C-QNN Hybrid Model"
	labeljust=c labelloc=t
	node [color=lightyellow shape=box style=filled]
	edge [color=black]
}
