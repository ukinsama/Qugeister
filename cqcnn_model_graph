// CQ-CNN Hybrid Model
digraph {
	rankdir=LR
	Input [label=Input color=lightgray shape=oval style=filled]
	subgraph cluster_cnn {
		color=lightblue label=CNN style=filled
		CNN0 [label="Conv2d(6->16)"]
		Input -> CNN0
		CNN1 [label=ReLU]
		CNN0 -> CNN1
		CNN2 [label="Conv2d(16->32)"]
		CNN1 -> CNN2
		CNN3 [label=ReLU]
		CNN2 -> CNN3
		CNN4 [label=Flatten]
		CNN3 -> CNN4
		CNN5 [label="Linear(?->4)"]
		CNN4 -> CNN5
		CNN_out [label="CNN Output"]
		CNN5 -> CNN_out
	}
	subgraph cluster_qnn {
		color=lightpink label=QNN style=filled
		QNN_input [label="QNN Input"]
		CNN_out -> QNN_input
		QNN0 [label=AngleEmbedding]
		QNN_input -> QNN0
		QNN1 [label=RealAmplitudes]
		QNN0 -> QNN1
		QNN2 [label=Expval]
		QNN1 -> QNN2
	}
	Output [label=Output color=lightgray shape=oval style=filled]
	QNN2 -> Output
}
